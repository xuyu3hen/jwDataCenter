{
  "@platforms": [
    "android",
    "iPhone",
    "iPad"
  ],
  "id": "H5466EEA4",
  "name": "机务数据中心",
  "version": {
    "name": "0.0.1",
    "code": "1"
  },
  "description": "机务数据中心",
  "developer": {
    "name": "",
    "email": "",
    "url": ""
  },
  "permissions": {
    "UniNView": {
      "description": "UniNView原生渲染"
    }
  },
  "plus": {
    "useragent": {
      "value": "uni-app",
      "concatenate": true
    },
    "splashscreen": {
      "autoclose": false,
      "waiting": true,
      "delay": 0
    },
    "popGesture": "close",
    "launchwebview": {
      "render": "always",
      "id": "1",
      "kernel": "WKWebview"
    },
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "distribute": {
      "icons": {
        "android": {
          "mdpi": "static/app-icons/mdpi.png",
          "hdpi": "static/app-icons/hdpi.png",
          "xhdpi": "static/app-icons/xhdpi.png",
          "xxhdpi": "static/app-icons/xxhdpi.png",
          "xxxhdpi": "static/app-icons/xxxhdpi.png"
        }
      },
      "google": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.INTERNET\"/>"
        ]
      },
      "plugins": {
        "audio": {
          "mp3": {
            "description": "Android平台录音支持MP3格式文件"
          }
        }
      }
    },
    "statusbar": {
      "immersed": "supportedDevice",
      "style": "dark",
      "background": "#000000"
    },
    "allowsInlineMediaPlayback": true,
    "uni-app": {
      "control": "uni-v3",
      "vueVersion": "3",
      "compilerVersion": "5.06",
      "nvueCompiler": "uni-app",
      "renderer": "auto",
      "nvue": {
        "flex-direction": "column"
      },
      "nvueLaunchMode": "normal",
      "webView": {
        "minUserAgentVersion": "49.0"
      }
    }
  },
  "app-harmony": {
    "useragent": {
      "value": "uni-app",
      "concatenate": true
    }
  },
  "launch_path": "__uniappview.html"
}